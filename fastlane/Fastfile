# Strata — App Store Connect automation via the App Store Connect API.
#
# Auth uses the existing ASC API key JSON (the same one the other iOS apps use):
#   ~/.appstoreconnect/fastlane_api_key.json   (key_id + issuer_id + key)
# Override with ASC_KEY_JSON if needed. No secrets live in this repo.
#
# Hard human gates the API cannot do (Apple requires them):
#   - Accept the Paid Applications Agreement (needed to sell a paid app)
#   - Complete tax + banking in ASC
#
# Lanes:
#   fastlane ios metadata  -> push listing metadata + screenshots only (no build, no submit)
#   fastlane ios upload    -> upload a built .ipa (set IPA_PATH), no submit
#   fastlane ios submit    -> submit the current build for review (PUBLISHES; run only on approval)

require "json"

ASC_KEY_JSON = File.expand_path(ENV["ASC_KEY_JSON"] || "~/.appstoreconnect/fastlane_api_key.json")
APP_ID = "app.lunary.strata"

platform :ios do
  # Authenticate every lane with the ASC API key (produce also reads it from here).
  # The key JSON stores the .p8 PEM inline under "key", so pass it as key_content.
  before_all do
    creds = JSON.parse(File.read(ASC_KEY_JSON))
    app_store_connect_api_key(
      key_id: creds["key_id"],
      issuer_id: creds["issuer_id"],
      key_content: creds["key"],
      is_key_content_base64: false,
      duration: 1200,
      in_house: false
    )
  end

  desc "Create the App Store Connect app record for Strata (draft only, no submit)"
  lane :create_asc_app do
    produce(
      app_identifier: APP_ID,
      app_name: "Strata",
      language: "en-GB",
      sku: "strata-ios",
      app_version: "1.0.0",
      skip_itc: false,
      skip_devcenter: false
    )
  end

  desc "Push listing metadata + screenshots (no build, no submit)"
  lane :metadata do
    deliver(
      api_key_path: ASC_KEY_JSON,
      app_identifier: APP_ID,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: true,
      skip_screenshots: Dir.glob("./fastlane/screenshots/**/*.png").empty?,
      submit_for_review: false,
      force: true,
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false
    )
  end

  desc "Upload a built .ipa (set IPA_PATH), no metadata, no submit"
  lane :upload do
    deliver(
      api_key_path: ASC_KEY_JSON,
      app_identifier: APP_ID,
      ipa: ENV.fetch("IPA_PATH"),
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: false
    )
  end

  desc "Submit the current build for review — PUBLISHES. Run only with explicit approval."
  lane :submit do
    deliver(
      api_key_path: ASC_KEY_JSON,
      app_identifier: APP_ID,
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      submission_information: { add_id_info_uses_idfa: false }
    )
  end

  desc "Archive a Release IPA for the App Store (Expo workspace)"
  lane :build_ipa do
    build_app(
      workspace: "./ios/Strata.xcworkspace",
      scheme: "Strata",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./fastlane/build",
      output_name: "Strata.ipa",
      clean: false,
      include_symbols: true,
      export_options: { method: "app-store", teamID: "ASG43SHM5N" }
    )
  end

  desc "Upload the archived IPA to TestFlight / App Store Connect"
  lane :testflight do
    upload_to_testflight(
      api_key_path: ASC_KEY_JSON,
      ipa: "./fastlane/build/Strata.ipa",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
