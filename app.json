{
  "expo": {
    "name": "Strata",
    "slug": "chronoline-app",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "description": "One engine, many worlds. Zoom a single scale from the ISS overhead to the edge of the universe, or across all of recorded history, everything to true scale.",
    "primaryColor": "#e8b84b",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.lunary.strata",
      "appleTeamId": "ASG43SHM5N",
      "buildNumber": "4",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.sammii.chronoline",
      "adaptiveIcon": {
        "backgroundColor": "#101218",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#101218",
          "dark": {
            "backgroundColor": "#101218"
          }
        }
      ],
      ["@bacons/apple-targets", { "appleTeamId": "ASG43SHM5N" }]
    ]
  }
}
